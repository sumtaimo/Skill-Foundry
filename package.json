{
  "name": "skill-foundry",
  "version": "1.4.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "dev": "node src/site/dev.mjs",
    "evals:live": "node src/factory/live-evals.mjs",
    "guard": "node src/factory/skill-guard.mjs",
    "foundry": "node src/factory/foundry.mjs",
    "release:check": "node src/factory/release-check.mjs",
    "setup": "git config core.hooksPath .githooks && echo \"skill-guard pre-commit hook on\""
  },
  "devDependencies": {
    "playwright": "^1.65.0"
  },
  "bin": {
    "skill-foundry": "src/factory/foundry.mjs"
  },
  "files": [
    "src/factory/foundry.mjs",
    "src/factory/registry.json",
    "src/skills/",
    "!src/skills/_template/",
    "!src/skills/skill-smith/",
    "CHANGELOG.md",
    "!src/skills/*/evals/",
    "README.md"
  ]
}
