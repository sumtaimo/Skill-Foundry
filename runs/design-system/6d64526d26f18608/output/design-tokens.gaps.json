        "$type": "number",
        "$value": 1.5
      },
      "heading": {
        "$type": "number",
        "$value": 1.25
      },
      "display": {
        "$type": "number",
        "$value": 1.2
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "strong": {
        "$type": "fontWeight",
        "$value": 600
      }
    },
    "measure": {
      "$type": "dimension",
      "$value": "65ch"
    }
  },
  "control": {
    "height-sm": {
      "$type": "dimension",
      "$value": "36px"
    },
    "height-md": {
      "$type": "dimension",
      "$value": "44px"
    },
    "height-lg": {
      "$type": "dimension",
      "$value": "52px"
    },
    "target-min": {
      "$type": "dimension",
      "$value": "44px",
      "$description": "Smallest click or tap area; extend small controls with padding or a pseudo-element."
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "6px"
    },
    "md": {
      "$type": "dimension",
      "$value": "10px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "16px"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px"
    },
    "control": {
      "$type": "dimension",
      "$value": "{radius.md}"
    }
  },
  "shadow": {
    "1": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(17, 24, 39, 0.06)",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "3px",
        "spread": "0px"
      }
    },
    "2": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(17, 24, 39, 0.08)",
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "12px",
        "spread": "-2px"
      }
    },
    "3": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(17, 24, 39, 0.1)",
        "offsetX": "0px",
        "offsetY": "12px",
        "blur": "32px",
        "spread": "-8px"
      }
    }
  },
  "border-width": {
    "hairline": {
      "$type": "dimension",
      "$value": "1px"
    },
    "thick": {
      "$type": "dimension",
      "$value": "2px"
    },
    "focus": {
      "$type": "dimension",
      "$value": "2px"
    }
  },
  "motion": {
    "duration-fast": {
      "$type": "duration",
      "$value": "150ms"
    },
    "duration-base": {
      "$type": "duration",
      "$value": "200ms"
    },
    "duration-slow": {
      "$type": "duration",
      "$value": "300ms"
    },
    "ease-standard": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    },
    "ease-enter": {
      "$type": "cubicBezier",
      "$value": [
        0,
        0,
        0.2,
        1
      ]
    },
    "ease-exit": {
      "$type": "cubicBezier",
      "$value": [
        0.4,
        0,
        1,
        1
      ]
    }
  },
  "breakpoint": {
    "sm": {
      "$type": "dimension",
      "$value": "640px",
      "$description": "CSS variables do not work inside media queries; copy this number there."
    },
    "md": {
