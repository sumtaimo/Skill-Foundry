{
  "$description": "Calm-workspace token set built from brand #7c3aed. Light roles under color.role.light, dark roles under color.role.dark.",
  "color": {
    "$type": "color",
    "brand": { "$value": "#7c3aed", "$description": "The given brand colour, unchanged (primary 500)." },
    "primary": {
      "50": { "$value": "#f6f2fc" }, "100": { "$value": "#eae1fa" }, "200": { "$value": "#d1bcf5" },
      "300": { "$value": "#b28df2" }, "400": { "$value": "#8f57ef" }, "500": { "$value": "#7c3aed" },
      "600": { "$value": "#5719c3" }, "700": { "$value": "#440f9f" }, "800": { "$value": "#300d6e" },
      "900": { "$value": "#1f0a42" }
    },
    "neutral": {
      "50": { "$value": "#f7f6f9" }, "100": { "$value": "#edecef" }, "200": { "$value": "#d9d7dc" },
      "300": { "$value": "#bfbcc4" }, "400": { "$value": "#a29ea9" }, "500": { "$value": "#85808e" },
      "600": { "$value": "#6c6774" }, "700": { "$value": "#55515c" }, "800": { "$value": "#3d3a42" },
      "900": { "$value": "#262429" }, "950": { "$value": "#141316" }
    },
    "success": {
      "50": { "$value": "#f3fcf6" }, "100": { "$value": "#e2f9ea" }, "200": { "$value": "#bff3d2" },
      "300": { "$value": "#91edb3" }, "400": { "$value": "#67df93" }, "500": { "$value": "#48c776" },
      "600": { "$value": "#2bb15c" }, "700": { "$value": "#16a34a" }, "800": { "$value": "#116a32" },
      "900": { "$value": "#0d4020" }
    },
    "warning": {
      "50": { "$value": "#fdf8f2" }, "100": { "$value": "#fbeedf" }, "200": { "$value": "#f9dbb8" },
      "300": { "$value": "#f9c386" }, "400": { "$value": "#faa94c" }, "500": { "$value": "#e68e28" },
      "600": { "$value": "#d97706" }, "700": { "$value": "#a95c05" }, "800": { "$value": "#744106" },
      "900": { "$value": "#462806" }
    },
    "danger": {
      "50": { "$value": "#fcf3f3" }, "100": { "$value": "#f8e2e2" }, "200": { "$value": "#f2c0c0" },
      "300": { "$value": "#eb9494" }, "400": { "$value": "#e66161" }, "500": { "$value": "#dc2626" },
      "600": { "$value": "#bd1e1e" }, "700": { "$value": "#951818" }, "800": { "$value": "#671313" },
      "900": { "$value": "#3f0e0e" }
    },
    "info": {
      "50": { "$value": "#f2f5fd" }, "100": { "$value": "#e0e8fa" }, "200": { "$value": "#bccef5" },
      "300": { "$value": "#8dacf2" }, "400": { "$value": "#5787f0" }, "500": { "$value": "#2563eb" },
      "600": { "$value": "#124cc9" }, "700": { "$value": "#0f3c9f" }, "800": { "$value": "#0d2b6e" },
      "900": { "$value": "#0a1c42" }
    },
    "role": {
      "light": {
        "surface-default": { "$value": "#ffffff" },
        "surface-subtle": { "$value": "{color.neutral.50}" },
        "surface-raised": { "$value": "#ffffff" },
        "surface-sunken": { "$value": "{color.neutral.100}" },
        "surface-inverse": { "$value": "{color.neutral.900}" },
        "text-default": { "$value": "{color.neutral.900}" },
        "text-muted": { "$value": "{color.neutral.600}" },
        "text-disabled": { "$value": "{color.neutral.400}", "$description": "Exempt from contrast." },
        "text-inverse": { "$value": "{color.neutral.50}" },
        "text-link": { "$value": "{color.primary.500}" },
        "text-link-hover": { "$value": "{color.primary.600}" },
        "border-default": { "$value": "{color.neutral.200}" },
        "border-strong": { "$value": "{color.neutral.500}" },
        "border-focus": { "$value": "{color.primary.500}" },
        "action-primary-bg": { "$value": "{color.primary.500}" },
        "action-primary-text": { "$value": "#ffffff" },
        "action-primary-bg-hover": { "$value": "{color.primary.600}" },
        "action-primary-bg-pressed": { "$value": "{color.primary.700}" },
        "action-secondary-text": { "$value": "{color.primary.500}" },
        "action-secondary-border": { "$value": "{color.primary.500}" },
        "selected-bg": { "$value": "{color.primary.50}" },
        "selected-text": { "$value": "{color.primary.600}" },
        "success-bg-subtle": { "$value": "{color.success.50}" },
        "success-border": { "$value": "{color.success.200}" },
        "success-text": { "$value": "{color.success.800}" },
        "success-bg": { "$value": "{color.success.700}" },
        "success-text-on": { "$value": "{color.neutral.900}" },
        "warning-bg-subtle": { "$value": "{color.warning.50}" },
        "warning-border": { "$value": "{color.warning.200}" },
        "warning-text": { "$value": "{color.warning.800}" },
        "warning-bg": { "$value": "{color.warning.600}" },
        "warning-text-on": { "$value": "{color.neutral.900}" },
        "danger-bg-subtle": { "$value": "{color.danger.50}" },
        "danger-border": { "$value": "{color.danger.200}" },
        "danger-text": { "$value": "{color.danger.600}" },
        "danger-bg": { "$value": "{color.danger.500}" },
        "danger-text-on": { "$value": "#ffffff" },
        "info-bg-subtle": { "$value": "{color.info.50}" },
        "info-border": { "$value": "{color.info.200}" },
        "info-text": { "$value": "{color.info.600}" },
        "info-bg": { "$value": "{color.info.500}" },
        "info-text-on": { "$value": "#ffffff" }
      },
      "dark": {
        "surface-default": { "$value": "{color.neutral.950}" },
        "surface-subtle": { "$value": "{color.neutral.900}" },
        "surface-raised": { "$value": "{color.neutral.800}" },
        "surface-sunken": { "$value": "{color.neutral.950}" },
        "surface-inverse": { "$value": "{color.neutral.50}" },
        "text-default": { "$value": "{color.neutral.50}" },
        "text-muted": { "$value": "{color.neutral.300}" },
        "text-disabled": { "$value": "{color.neutral.600}", "$description": "Exempt from contrast." },
        "text-inverse": { "$value": "{color.neutral.900}" },
        "text-link": { "$value": "{color.primary.200}" },
        "text-link-hover": { "$value": "{color.primary.100}" },
        "border-default": { "$value": "{color.neutral.800}" },
        "border-strong": { "$value": "{color.neutral.400}" },
        "border-focus": { "$value": "{color.primary.300}" },
        "action-primary-bg": { "$value": "{color.primary.500}" },
        "action-primary-text": { "$value": "#ffffff" },
        "action-primary-bg-hover": { "$value": "{color.primary.600}" },
        "action-primary-bg-pressed": { "$value": "{color.primary.700}" },
        "action-secondary-text": { "$value": "{color.primary.200}" },
        "action-secondary-border": { "$value": "{color.primary.300}" },
        "selected-bg": { "$value": "{color.primary.900}" },
        "selected-text": { "$value": "{color.primary.200}" },
        "success-bg-subtle": { "$value": "{color.success.900}" },
        "success-border": { "$value": "{color.success.700}" },
        "success-text": { "$value": "{color.success.400}" },
        "success-bg": { "$value": "{color.success.700}" },
        "success-text-on": { "$value": "{color.neutral.900}" },
        "warning-bg-subtle": { "$value": "{color.warning.900}" },
        "warning-border": { "$value": "{color.warning.700}" },
        "warning-text": { "$value": "{color.warning.400}" },
        "warning-bg": { "$value": "{color.warning.600}" },
        "warning-text-on": { "$value": "{color.neutral.900}" },
        "danger-bg-subtle": { "$value": "{color.danger.900}" },
        "danger-border": { "$value": "{color.danger.700}" },
        "danger-text": { "$value": "{color.danger.300}" },
        "danger-bg": { "$value": "{color.danger.500}" },
        "danger-text-on": { "$value": "#ffffff" },
        "info-bg-subtle": { "$value": "{color.info.900}" },
        "info-border": { "$value": "{color.info.700}" },
        "info-text": { "$value": "{color.info.300}" },
        "info-bg": { "$value": "{color.info.500}" },
        "info-text-on": { "$value": "#ffffff" }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"] },
      "heading": { "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"] },
      "mono": { "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "12px" }, "sm": { "$value": "14px" }, "md": { "$value": "16px" },
      "lg": { "$value": "20px" }, "xl": { "$value": "24px" }, "2xl": { "$value": "30px" }, "3xl": { "$value": "36px" }
    },
    "line-height": {
      "$type": "number",
      "body": { "$value": 1.5 }, "heading": { "$value": 1.25 }, "display": { "$value": 1.2 }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 }, "strong": { "$value": 600 }
    },
    "measure": { "$type": "number", "$value": 65, "$description": "Line length in characters (CSS: 65ch)." }
  },
  "space": {
    "$type": "dimension",
    "0": { "$value": "0px" }, "4": { "$value": "4px" }, "8": { "$value": "8px" }, "12": { "$value": "12px" },
    "16": { "$value": "16px" }, "24": { "$value": "24px" }, "32": { "$value": "32px" },
    "48": { "$value": "48px" }, "64": { "$value": "64px" }
  },
  "control": {
    "$type": "dimension",
    "height-sm": { "$value": "36px" }, "height-md": { "$value": "44px" }, "height-lg": { "$value": "52px" },
    "target-min": { "$value": "44px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "6px" }, "md": { "$value": "10px" }, "lg": { "$value": "16px" },
    "full": { "$value": "9999px" }, "control": { "$value": "{radius.md}" }
  },
  "shadow": {
    "$type": "shadow",
    "1": { "$value": { "color": "#0000000f", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" } },
    "2": { "$value": { "color": "#00000014", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "-2px" } },
    "3": { "$value": { "color": "#0000001a", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "-8px" } },
    "dark": {
      "1": { "$value": { "color": "#0000002e", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" } },
      "2": { "$value": { "color": "#0000003d", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "-2px" } },
      "3": { "$value": { "color": "#0000004d", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "-8px" } }
    }
  },
  "border-width": {
    "$type": "dimension",
    "hairline": { "$value": "1px" }, "thick": { "$value": "2px" }, "focus": { "$value": "2px" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "150ms" }, "base": { "$value": "200ms" }, "slow": { "$value": "300ms" }
    },
    "ease": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "enter": { "$value": [0, 0, 0.2, 1] },
      "exit": { "$value": [0.4, 0, 1, 1] }
    },
    "$description": "All durations are 0ms under reduced motion (see tokens.css)."
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "640px" }, "md": { "$value": "768px" }, "lg": { "$value": "1024px" }, "xl": { "$value": "1280px" }
  },
  "density": {
    "$type": "dimension",
    "$description": "Default is spacious. Compact: 8, 4, 32, 8, 24. Comfortable: 12, 8, 40, 12, 32.",
    "control-x": { "$value": "16px" }, "control-y": { "$value": "12px" }, "row": { "$value": "48px" },
    "stack": { "$value": "16px" }, "section": { "$value": "48px" },
    "compact": {
      "control-x": { "$value": "8px" }, "control-y": { "$value": "4px" }, "row": { "$value": "32px" },
      "stack": { "$value": "8px" }, "section": { "$value": "24px" }
    },
    "comfortable": {
      "control-x": { "$value": "12px" }, "control-y": { "$value": "8px" }, "row": { "$value": "40px" },
      "stack": { "$value": "12px" }, "section": { "$value": "32px" }
    }
  }
}
